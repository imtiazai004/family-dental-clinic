{
  "name": "family-dental-clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-export.mjs",
    "launch-check": "node --no-warnings scripts/launch-check.mjs",
    "build:launch": "npm run launch-check && npm run build",
    "preview": "npx serve out",
